#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Runs Python with pcbnew from the same pinned image as scripts/kicad-cli.
# Home/current-directory mounts and the user's uid/gid match the CLI wrapper.
# Usage: scripts/kicad-python script.py args... (or -c '...' args...).
IMG="${TRACEMAKER_KICAD_IMAGE:-kicad/kicad:10.0.6}"
mounts=(-v "$HOME:$HOME")
case "$PWD/" in "$HOME"/*) ;; *) mounts+=(-v "$PWD:$PWD") ;; esac
args=(run --rm -i -u "$(id -u):$(id -g)" -e HOME=/tmp "${mounts[@]}" -w "$PWD" --entrypoint python3 "$IMG" "$@")
if docker info >/dev/null 2>&1; then exec docker "${args[@]}"; fi
# This shell started before the user joined the docker group: run through 'sg docker'.
exec sg docker -c "docker $(printf '%q ' "${args[@]}")"
