{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "60;70"
      },
      "environment": {
        "PATH": "/usr/bin:/usr/local/bin:$penv{PATH}"
      }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TM_ENABLE_CUDA": "OFF",
        "TM_WERROR": "ON"
      }
    },
    {
      "name": "macos-cpu",
      "inherits": "macos-base",
      "displayName": "Native macOS (CPU)",
      "cacheVariables": {
        "TM_ENABLE_METAL": "OFF"
      }
    },
    {
      "name": "macos-metal",
      "inherits": "macos-base",
      "displayName": "Native macOS (Metal)",
      "cacheVariables": {
        "CMAKE_OBJCXX_COMPILER": "/usr/bin/clang++",
        "TM_ENABLE_METAL": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug (CUDA)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release (CUDA)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "cpu-only",
      "inherits": "base",
      "displayName": "Release without CUDA",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TM_ENABLE_CUDA": "OFF"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "ASan + UBSan (CPU only)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TM_ENABLE_CUDA": "OFF",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "TSan (CPU only)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TM_ENABLE_CUDA": "OFF",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-cpu",
      "configurePreset": "macos-cpu"
    },
    {
      "name": "macos-metal",
      "configurePreset": "macos-metal"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "cpu-only",
      "configurePreset": "cpu-only"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    }
  ],
  "testPresets": [
    {
      "name": "macos-cpu",
      "configurePreset": "macos-cpu",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-metal",
      "configurePreset": "macos-metal",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cpu-only",
      "configurePreset": "cpu-only",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
