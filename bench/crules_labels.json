 "about": "Hand-labelled component categories on PCBench boards (doc 15 §9.1 L1), labelled 2026-10-04 from footprint names, values and nets (no schematics). Each board lists, per category, the references a human sees as that category; a category missing from a board's labels means the board has none. 'ignore' lists references whose label is ambiguous; they count neither way. ic_decoupling is labelled only on the boards that carry an ic_decoupling key. Scored by bench/crules_detect.py.",
 "fixtures": "bench/data/freerouting/scripts/benchmark/fixtures/PCBench/<board>/unrouted.kicad_pcb",
 "categories": ["crystal", "oscillator", "usb2", "esd_tvs", "ldo", "buck", "boost", "rf_module", "can", "rs485", "connector_general", "mounting_hole"],
 "definitions": {
  "crystal": "quartz crystal or ceramic resonator (2, 3 or 4 pads)",
  "oscillator": "active oscillator module (MEMS/XO), not a passive crystal",
  "usb2": "any USB receptacle or plug footprint (A, B, mini, micro, C, board-mount OTG), with or without data lines; a pin header named USB is not one",
  "esd_tvs": "a part made for ESD/transient protection: TVS diodes (SMAJ, SMBJ, SM24, PESD, PRTR), ESD arrays and USB ESD/EMI filters (USBLC6, STF202, NUF2042); Zeners, Schottkys and generic clamp diodes (BAV99) are not, or are ignored when used as clamps",
  "ldo": "linear regulator (78xx, 1117, MCP1700/1703, AP2112, XC6206, ...)",
  "buck": "step-down switching regulator IC",
  "boost": "step-up switching regulator IC (incl. LED boost drivers); buck-boost parts are ignored",
  "rf_module": "radio module with its own antenna (ESP32/ESP8266 modules, RFM95, nRF52 modules); a socket for a plugged module is ignored",
  "can": "CAN transceiver IC",
  "rs485": "RS-485/RS-422 transceiver IC",
  "connector_general": "board-to-wire/board-to-board connector: headers, sockets, terminal blocks, JST/Molex, USB, RJ, barrel jacks, card sockets, RF connectors, castellated edge pads; jumpers, test pins and module footprints are not (or are ignored)",
  "mounting_hole": "mechanical mounting hole, whatever its reference",
  "ic_decoupling": "capacitor between a supply (or an IC's local supply node, VDDA, AREF, regulator in/out) and ground that serves an IC's power pin; crystal load caps, signal filters, AC coupling and LED-driver outputs are not"
 },
